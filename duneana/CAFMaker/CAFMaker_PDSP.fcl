#include "calorimetry_pdune.fcl"

BEGIN_PROLOG

dunepdsp_cafmaker:
{
    module_type:                "CAFMaker"
    CreateFlatCAF:              false

    CVNLabel:                   "cvneva:cvnresult"
    IsAtmoCVN:                  false #Hotfix to take care of the fact that the CVN for atmospherics is storing results in a weird way...
    RegCNNLabel:                "regcnneval"
    EnergyRecoCaloLabel:        "energyrecnc"
    EnergyRecoLepCaloLabel:     "energyrecnumu"
    EnergyRecoMuRangeLabel:     "energyrecnumurange"
    EnergyRecoMuMcsLabel:       "energyrecnumumcs"
    EnergyRecoMuMcsLLHDLabel:   "energyrecnumumcsllhd"
    EnergyRecoECaloLabel:       "energyrecnue"
    DirectionRecoLabelNue:      "anglereconuepfps"
    DirectionRecoLabelNumu:     "anglereconumupfps"
    DirectionRecoLabelCalo:     "anglerecohits"
    PandoraLabel:               "pandora"
    ParticleIDLabel:            "pandorapid"
    # MCTruthLabel:               "generator"
    # MCTruthLabel:               [ "generator", "cosmicgenerator" ] 
    MCTruthLabel:               [ "generator" ] 
    GTruthLabel:                "generator"
    MCFluxLabel:                "generator"
    POTSummaryLabel:            "generator"
    TrackLabel:                 "pandoraTrack"
    ShowerLabel:                "pandora2Shower"
    SpacePointLabel:            "pandora"
    HitLabel:                   "hitpdune"
    G4Label:                    "largeant"
    MVALabel:                   "emtrkmichelid:emtrkmichel"

    VertexFiducialVolumeCut:    [ 20, 20, 20, 20, 20, 20 ] #FV cut margins for all directions minX, maxX, minY, maxY, minZ, maxZ (in cm)
    ContainedDistThreshold:     20 #Distance from the edge of the AV to be considered contained (in cm)

    CalorimetryAlg:             @local::pdune_sp_calorimetryalgmc
    RecombFactor:               0.63 #Average recombination factor used the the hits not attached to a PFP
    CalorimetryLabelSCE:        "pandoracalinoxyzt"
    VPlaneAsCollector:          false
    PFParticleLabel:            "pandora"
    MCHasBI:                    true

    # Hit-level truth composition per slice and event-wide (slicing quality / energy resolution).
    # Hits are classified by which generator produced their true ionisation, so these labels must
    # match the generator module labels in the input file. Anything not listed (ar39, ar42, kr85,
    # rn222, ...) is counted as "other".
    FillHitSummaries:           true
    BeamTruthLabels:            [ "generator" ]
    CosmicTruthLabels:          [ "cosmicgenerator" ]

}


END_PROLOG
